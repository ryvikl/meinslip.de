# Vorlage fuer .env — diese Datei gehoert ins Repository, .env NIEMALS.
#
# Zum Einrichten:  cp .env.example .env  und Werte eintragen.
#
# WICHTIG: Zugangsdaten gehoeren ausschliesslich in .env. Wurden sie jemals
# in einem Chat, einer E-Mail oder einem Ticket geteilt, sind sie verbrannt
# und muessen im KAS-Adminbereich neu gesetzt werden.

# --- Anwendung -------------------------------------------------------------
APP_NAME="MeinSlip"
APP_URL="https://meinslip.de"
APP_UMGEBUNG=produktion          # produktion | test | entwicklung
APP_DEBUG=false                  # in Produktion immer false
APP_SPRACHE=de-DE

# Schluessel fuer Sitzungen und signierte Medienadressen.
# Erzeugen mit:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SCHLUESSEL=

# Einmal-Token fuer die Einrichtung ueber den Browser (/einrichten?token=...).
# Mindestens 16 Zeichen. NACH der Einrichtung wieder leeren.
# Erzeugen mit:  php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
EINRICHTUNG_TOKEN=

# Dauerhafter Token fuer die Deployment-Automatik (POST /deploy/migrieren).
# Mindestens 24 Zeichen, sonst ist der Endpunkt gesperrt. Muss mit dem
# GitHub-Geheimnis DEPLOY_TOKEN uebereinstimmen. Leer lassen, wenn kein
# automatisches Deployment genutzt wird — dann ist die Route komplett zu.
# Erzeugen mit:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
DEPLOY_TOKEN=

# --- Datenbank -------------------------------------------------------------
# Produktiv MySQL auf dem All-Inkl-Webhosting.
DB_TREIBER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_BENUTZER=
DB_PASSWORT=

# Fuer lokale Tests stattdessen:
# DB_TREIBER=sqlite
# DB_PFAD=storage/test.sqlite

# --- Vorschau-Schranke -----------------------------------------------------
# Legt die GESAMTE Seite hinter ein gemeinsames Passwort (Formular, Cookie
# fuer 30 Tage). Warum: Die Impressumspflicht des § 5 DDG trifft oeffentlich
# zugaengliche geschaeftsmaessige Dienste. Solange die Rechtstexte Entwuerfe
# sind, darf die Seite deshalb nicht oeffentlich stehen — eine
# passwortgeschuetzte Vorschau ist nach ueberwiegender Auffassung kein
# oeffentliches Angebot und loest die Pflicht nicht aus. Keine Garantie:
# vor dem oeffentlichen Start anwaltlich bestaetigen lassen.
#
#  - leer            = Schranke aus, Seite bewusst OEFFENTLICH
#  - unter 12 Zeichen = Seite fuer ALLE zu (503) — die Schranke faellt
#                       geschlossen aus, nie offen
#  - /deploy/migrieren bleibt ausgenommen (eigenes Token), sonst braeche
#    das automatische Deployment
#
# Erzeugen:  php -r "echo bin2hex(random_bytes(12)), PHP_EOL;"
VORSCHAU_PASSWORT=

# --- Bestellvorgang --------------------------------------------------------
# Riegel vor der gesamten Kasse. Bestellungen::anlegen() wirft
# BestellvorgangGesperrt, solange dieser Wert nicht ausdruecklich auf true
# steht.
#
# Grund: Bezahlt wird ueber das Guthaben, und das ist gesperrt, weil ein
# aufladbares, jederzeit rueckforderbares Guthaben ein erlaubnispflichtiges
# Einlagengeschaeft nach § 1 Abs. 1 S. 2 Nr. 1 KWG sein kann. Eine Bestellung
# ohne Zahlweg waere eine Forderung, die niemand erfuellen kann.
#
# Der Riegel sitzt in der Fachklasse, nicht in einer Route. In der Route
# waere er wertlos: die naechste Route, die eine Bestellung braucht, oeffnete
# die Frage aus Versehen wieder.
#
# Solange er aus ist, ist "Nachricht schreiben" die Hauptaktion der
# Angebotsseite — wie auf einem Kleinanzeigenmarkt.
BESTELLVORGANG_AKTIV=false

# --- Provision -------------------------------------------------------------
# Hundertstel Prozent: 1500 = 15,00 Prozent.
# Zum Vergleich aus der Marktanalyse: deutsche Alt-Portale behalten 70 bis 75
# Prozent ein, der internationale Standard liegt bei 20 Prozent Plattformanteil.
PROVISION_SATZ=1500

# --- Fristen ---------------------------------------------------------------
EINSPRUCHSFENSTER_STUNDEN=72
ANNAHMEFRIST_STUNDEN=48

# --- Altersverifikation ----------------------------------------------------
# Es wird KEIN eigenes Verfahren gebaut. Es muss ein von der KJM positiv
# bewertetes Verfahren lizenziert und exakt wie bewertet eingebunden werden.
# Achtung: Pro Produkt pruefen, fuer WELCHE Norm die Bewertung gilt —
# § 4 Abs. 2 JMStV (geschlossene Benutzergruppe) oder nur § 5 Abs. 3 Nr. 1.
AV_ANBIETER=
AV_SCHLUESSEL=
AV_GEHEIMNIS=

# --- Zahlungsdienstleister -------------------------------------------------
# Noch nicht ausgewaehlt. Die Kombination aus lizenziertem Wallet, Treuhand
# und Adult-Akzeptanz existiert moeglicherweise nicht als fertiges Produkt —
# siehe docs/07-zahlungsverkehr.md und docs/11-offene-fragen.md.
PSP_ANBIETER=
PSP_SCHLUESSEL=
PSP_GEHEIMNIS=
# So erscheint die Buchung auf dem Kontoauszug. Muss unauffaellig, aber ECHT
# sein — Visa und Mastercard verlangen, dass der Haendler erkennbar ist.
PSP_DESKRIPTOR=

# --- Versand ---------------------------------------------------------------
VERSAND_ANBIETER=dhl
VERSAND_SCHLUESSEL=
VERSAND_GEHEIMNIS=
# Absenderanschrift der GmbH. Ein Postfach funktioniert NICHT — es nimmt keine
# Pakete an und faellt damit als Retourenziel aus.
VERSAND_ABSENDER_NAME=
VERSAND_ABSENDER_STRASSE=
VERSAND_ABSENDER_PLZ=
VERSAND_ABSENDER_ORT=

# --- Push ------------------------------------------------------------------
# Erzeugen mit:  npx web-push generate-vapid-keys
VAPID_OEFFENTLICH=
VAPID_PRIVAT=
VAPID_KONTAKT=mailto:

# --- E-Mail ----------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_BENUTZER=
MAIL_PASSWORT=
MAIL_ABSENDER=
