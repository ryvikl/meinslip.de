# Vorlage für deployment/.deploy.env
#
# Kopieren:  cp deployment/deploy.env.example deployment/.deploy.env
#
# Die Datei .deploy.env ist in .gitignore erfasst und darf NIE committet werden.

# SFTP über Port 22 — niemals FTP über Port 21. Auf Port 21 gehen Passwort
# und Dateien im Klartext über die Leitung.
SFTP_HOST=
SFTP_PORT=22
SFTP_BENUTZER=

# Absoluter Pfad auf dem Server. Das Dokumentenstammverzeichnis der Domain
# muss im KAS-Adminbereich auf das Unterverzeichnis public/ zeigen.
SFTP_ZIEL=/www/htdocs/BENUTZER/meinslip

# Betriebsprüfung nach dem Deployment.
PRUEF_URL=https://meinslip.de/zustand

# Empfehlung: Statt eines Passworts einen SSH-Schlüssel hinterlegen.
# Erzeugen:   ssh-keygen -t ed25519 -C "deployment meinslip"
# Übertragen: ssh-copy-id -p 22 BENUTZER@HOST
# Danach fragt das Deployment nicht mehr nach einem Passwort, und das
# Passwort muss nirgends gespeichert werden.
