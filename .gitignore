# === Zugangsdaten und Geheimnisse — NIEMALS committen ===
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
auth.json
credentials*
secrets*
deploy.config*
.netrc
.ftpconfig
sftp-config.json

# === Abhängigkeiten ===
/vendor/
/node_modules/

# === Build und Cache ===
/dist/
/build/
/.cache/
/var/cache/
/storage/cache/
*.log

# === Hochgeladene Dateien und Nutzerinhalte ===
/storage/uploads/
/storage/media/
# Der tatsächliche Ablageort der Bilder (Medien::verzeichnis()). Die englische
# Zeile darüber stand hier von Anfang an und traf nie zu — ein einziger
# Buchstabe Unterschied, und jedes hochgeladene Wäschefoto wäre beim nächsten
# `git add .` im Repository und von dort aus in der Historie gelandet.
# Unwiderruflich: Ein Bild aus der Git-Historie zu entfernen heißt, jede
# Kopie des Repositories neu zu schreiben.
/storage/medien/
# Die Prüfbelege (Pruefbelege::verzeichnis()). Ein Selfie mit einem
# handgeschriebenen Zettel ist das Empfindlichste, was diese Anwendung je
# entgegennimmt — und das einzige, dem die Datenbank ein Löschdatum aufzwingt.
# In der Git-Historie wäre dieses Löschdatum wirkungslos: Ein Bild aus der
# Historie zu entfernen heißt, jede Kopie des Repositories neu zu schreiben.
/storage/belege/
/public/uploads/

# === Datenbank-Abzüge ===
*.sql
*.sql.gz
*.dump
!/database/migrations/*.sql
!/database/schema.sql

# === Editor und System ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

